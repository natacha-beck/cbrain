<% title t('.title') %>

<h2><%= t('.title') %></h2>

<%= error_messages_for @tool %>

<%= form_for @tool, :as => :tool, :url => { :action => "create" }, :datatype => "script" do |f| -%>

  <div class="generalbox">
      <p>
       <%= f.label :name, t('tools.common.label.name') %>
       <%= f.text_field :name %>
      </p>

      <p>
        <span title="<%= t('tools.common.title_cbrain_task_class') %>">
           <%= f.label :cbrain_task_class_name, t('.label.cbrain_task_class') %>
           <%= f.text_field :cbrain_task_class_name %>
        </span>
      </p>

      <p>
       <%= f.label :user_id, t('tools.common.label.belongs_to') %>
       <%= user_select "tool[user_id]", @tool, :id => 'tool_user_id' %>
      </p>

      <p>
       <%= f.label :group_id, t('tools.common.label.available_to_project') %>
       <%= group_select "tool[group_id]", @tool, :id => 'tool_group_id' %>
      </p>

      <p>
        <%= f.label :category, t('tools.common.label.category') %>
        <%= f.select :category, Tool::Categories %>
      </p>

      <p>
        <%= f.label :license_agreements, t('tools.common.label.license_agreements') %><br>
        <%= f.text_area :license_agreements, :value => @tool.new_record? ? "" : @tool.license_agreements.join("\n") , :rows => 5, :cols => 40 %>
        <div class="field_explanation"><%= t('tools.common.field_explanation.license_agreements') %></div>
      </p>

      <p>
        <%= f.label :description, t('tools.common.label.description') %><br>
        <%= f.text_area :description, :cols => 80, :rows => 10 %><br>
        <div class="field_explanation"><%= t('.field_explanation.description') %></div>
      </p>

      <p>
        <%= f.label :application_package_name, t('tools.common.label.package_name') %><br>
        <%= f.text_field :application_package_name %><br>
      </p>

      <p>
        <%= f.label :application_type, t('tools.common.label.tool_type') %><br>
        <%= f.text_field :application_type %><br>
      </p>

      <p>
        <%= f.label :application_tags, t('tools.common.label.comma_separated_tags') %><br>
        <%= f.text_field :application_tags %><br>
      </p>

      <p>
        <%= f.label :url, t('tools.common.label.url') %><br>
        <%= f.text_field :url %><br>
      </p>

      <p>
        <%= f.label :select_menu_text, t('tools.common.label.select_menu_text') %>
        <%= f.text_field :select_menu_text %>
      </p>
  </div>

  <p><%= f.submit t('.submit_create') %></p>

<% end %>


