<div class="menu_bar">
  <%= external_submit_button t('.delete_checked'), "exception_form", :class  => "button", :confirm  => t('confirm_delete', name: t('confirm_delete_name'))  %>
</div>

<%=
  render(:partial => 'shared/active_filters', :locals  => {
    :scope => @scope,
    :model => ExceptionLog
  })
%>

<div class="pagination">
  <span class="page_links">
    (<%= t('.message_count', count: @exception_logs.total_entries) %>)
  </span>
</div>

<%= ajax_form_tag(url_for(:action => :destroy), :method => :delete, :datatype => :script, :id => "exception_form") do %>
  <%=
    dynamic_scoped_table(@exception_logs,
      :id         => 'exception_logs_table',
      :class      => [ :resource_list ],
      :scope      => @scope,
      :order_map  => {
        :user => { :a => 'users.login', :j => User }
      },
      :filter_map => {
        :user => { :a => 'user_id' }
      }
    ) do |t|
  %>
    <%
      generic_column = lambda do |label,field|
        t.column(label, field,
          :sortable => true,
          :filters  => default_filters_for(@base_scope, field)
        )
      end

      t.paginate
      t.selectable('exception_log_ids[]')

      t.column(t('activerecord.models.exception', count: 1), :exception_class,
        :sortable => true,
        :filters  => default_filters_for(@base_scope, :exception_class)
      ) { |e| link_to e.exception_class, e }

      t.column(t('.col.message'), :message) { |e| crop_text_to(75, e.message) }

      generic_column.(t('exception_logs.common.method'), :request_method)
      generic_column.(t('.col.controller'),              :request_controller)
      generic_column.(t('.col.action'),                  :request_action)
      generic_column.(t('exception_logs.common.format'), :request_format)

      t.column(t('activerecord.models.user', count: 1), :user,
        :sortable => true,
        :filters  => default_filters_for(@view_scope, User)
      ) { |e| link_to_user_with_tooltip(e.user) }

      generic_column.(t('.col.revision'),   :revision_no)

      t.column(t('exception_logs.common.raised_at'), :created_at,
        :sortable => true
      ) { |e| to_localtime(e.created_at, :datetime) }
    %>
  <% end %>
<% end %>
