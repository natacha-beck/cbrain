<% title t('.title') %>

<h2><%= t('.heading') %></h2>

<%= error_messages_for(@provider) %>

<%= form_for @provider, :as => :data_provider, :url => { :action => "create_personal" }, :datatype => "script" do |f| -%>

  <%
    # Note about the type: the form currently only supports the UserkeyFlatDirSshDataProvider
    # but the controller also supports the S3MultiLevelDataProvider. Eventually we
    # will allow both. If a user modifies the form in their browser they can still create
    # their own S3 type, but that's ok.
  %>
  <%= hidden_field_tag 'data_provider[type]', 'UserkeyFlatDirSshDataProvider' %>

  <div class="generalbox">

    <div title="<%= t('data_providers.common.name') %>">
      <%= f.label :name, t('activerecord.attributes.data_provider.name') %><br>
      <%= f.text_field :name %>
      <div class="field_explanation"><%= t('.field_explanation.name') %></div>
    </div>

    <p>

    <div title="<%= t('t('data_providers.common.description')') %>">
      <%= f.label :description, t('activerecord.attributes.data_provider.description') %><br>
      <%= f.text_area :description, :rows => 3, :cols => 85 %>
      <div class="field_explanation"><%= t('data_providers.common.field_explanation.description') %></div>
    </div>

    <p>

    <div title="<%= t('.titles.group') %>">
      <%= f.label :group_id, t('activerecord.models.group.one') %><br>
      <%= group_select("data_provider[group_id]", { :groups => @groups, :selector => @provider.group_id.to_s }) %>
      <div class="field_explanation"><%= t('.field_explanation.group_html', group: current_user.own_group.name) %></div>
    </div>

    <p>

    <fieldset class="groupentry">
      <legend><%= t('data_providers.common.ssh_params') %></legend>

      <div title="<%= t('.titles.remote_host') %>">
        <%= f.label :remote_host, t('activerecord.attributes.data_provider.remote_host') %><br>
        <%= f.text_field :remote_host, :size => 40 %>
      </div>

      <p>

      <div title="<%= t('.titles.remote_user') %>">
        <%= f.label :remote_user, t('activerecord.attributes.data_provider.remote_user') %><br>
        <%= f.text_field :remote_user, :size => 40 %>
      </div>

      <p>

      <div title="<%= t('.titles.remote_port') %>">
        <%= f.label :remote_port, t('activerecord.attributes.data_provider.remote_port') %><br>
        <%= f.text_field :remote_port, :size => 6 %>
      </div>

      <p>

      <div title="<%= t('data_providers.common.description') %>">
        <%= f.label :remote_dir, t('activerecord.attributes.data_provider.remote_dir') %><br>
        <%= f.text_field :remote_dir, :size => 80 %>
      </div>

    </fieldset>
  </div>

  <p>

  <%= render :partial => 'show_user_key' %>

  <p>

  <%= submit_tag t('data_providers.common.create_new_dp') %></p>

<% end %>

