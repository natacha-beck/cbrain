<% title t('.title') %>

<h1><%= t('.heading') %></h1>

<% if current_user.present? && current_user.has_role?(:admin_user) %>

  <% if @signup.remote_resource %>
    <%= t('.made_from_portal_html', portal: link_to_bourreau_if_accessible(@signup.remote_resource), form_page: @signup.form_page) %>
  <% end %>

  <%= t('.admin_can_edit_html', link: link_to(t('edit').downcase, :action => :edit)) %><p>

  <% if ! @signup.approved? %>

    <% if @signup.dup_login? %>
      <span class="warning"><%= t('.login_conflict') %></span>
    <% else %>
      <%= t('.can_approve_html', link: link_to(t('.approve'), new_user_path(:signup_id => @signup.id), :class => 'action_link')) %>
    <% end %>

    <% if ! @signup.confirmed? %>
      <span class="warning"><%= t('.not_confirmed') %></span>
    <% else %>
      <%= t('.confirmed') %>
    <% end %>

    <p>
    <%= t('.resend_admin_html', link: link_to(t('.email_confirmation_request'), resend_confirm_signup_path(@signup), :method => :post)) %>

  <% end %>

<% else %>

  <p>
  <%= t('.edit_session_note_html', link: link_to(t('edit'), :action => :edit)) %>

<% end %>

<% if current_user.blank? && ! @signup.confirmed? %>
  <p>
  <%= t('.confirmation_sent') %>
  <p>
  <%= t('.resend_user_html', link: link_to(t('.email_confirmation_request'), resend_confirm_signup_path(@signup), :method => :post)) %>
<% end %>

<p>
<%= t('.delete_html', link: link_to(t('.delete'), signup_path(@signup), :action => :destroy, :method => :delete, :data => { :confirm => t('.delete_confirm', name: @signup.full_name) })) %>

<p>
<%= t('.summary_intro') %>

<p>
  <table class="simple bordered">

  <tr>
    <th><%= t('.full_name') %></th>
    <td><%= @signup.full_name %></td>
  </tr>

  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>

  <tr>
    <th><%= t('.login') %></th>
    <td><%= @signup.login.presence || t('.none') %></td>
  </tr>

  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>

  <tr>
    <th><%= t('.institution') %></th>
    <td><%= @signup.institution %></td>
  </tr>

  <tr>
    <th><%= t('.department') %></th>
    <td><%= @signup.department %></td>
  </tr>

  <tr>
    <th><%= t('.position') %></th>
    <td><%= @signup.position %></td>
  </tr>

  <tr>
    <th><%= t('.affiliation') %></th>
    <td><%= @signup.affiliation %></td>
  </tr>

  <tr>
    <th><%= t('.email') %></th>
    <td><%= @signup.email %></td>
  </tr>

  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>

  <tr>
    <th><%= t('.street1') %></th>
    <td><%= @signup.street1 %></td>
  </tr>

  <tr>
    <th><%= t('.street2') %></th>
    <td><%= @signup.street2 %></td>
  </tr>

  <tr>
    <th><%= t('.city') %></th>
    <td><%= @signup.city %></td>
  </tr>

  <tr>
    <th><%= t('.province') %></th>
    <td><%= @signup.province %></td>
  </tr>

  <tr>
    <th><%= t('.country') %></th>
    <td><%= @signup.country %></td>
  </tr>

  <tr>
    <th><%= t('.postal_code') %></th>
    <td><%= @signup.postal_code %></td>
  </tr>

  <tr>
    <th><%= t('time_zone') %></th>
    <td><%= @signup.time_zone %></td>
  </tr>

  <tr>
    <td>&nbsp;</td>
    <td>&nbsp;</td>
  </tr>

  <% if @signup.comment.present? %>

    <tr>
      <th><%= t('signups.common.comment') %></th>
      <td><pre><%= @signup.comment %></pre></td>
    </tr>

    <tr>
      <td>&nbsp;</td>
      <td>&nbsp;</td>
    </tr>

  <% end %>

  <% if current_user.present? && current_user.has_role?(:admin_user) %>

    <tr>
      <th><%= t('.admin_comments') %></th>
      <td><pre><%= @signup.admin_comment %></pre></td>
    </tr>

    <tr>
      <td>&nbsp;</td>
      <td>&nbsp;</td>
    </tr>

  <% end %>

  <tr>
    <th><%= t('.status_of_request') %></th>
    <td>
      <%= render :partial => 'status', :locals => { :signup => @signup, :multi_lines => true } %>
    </td>
  </tr>

  </table>

