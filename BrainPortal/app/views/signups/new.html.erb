<% title t('.title') %>

<%= form_for @signup, :url => {:action => (@signup.new_record? ? "create" : "update"), :id => @signup.id} do |f| %>
  <%= error_messages_for @signup %>
  <%= hidden_field_tag(:auth_spec, (@auth_spec.to_s.presence || Time.now.to_i.to_s)) %>

  <div class="generalbox">
    <p class="warning"> <%= t('.mandatory_fields_html') %></p>

    <fieldset class="groupentry">

      <legend>
        <%= t('.personal_info') %>
      </legend>

      <div class="tree-column-grid">

        <%= f.label(:title, t('.label.title')) %>
        <%= f.text_field :title %>
        <span class="wide_field_explanation"><%= t('.explanation.title_html') %></span>

        <%= f.label(:first, t('.label.first')) %>
        <%= f.text_field :first %>
        <br>

        <%= f.label(:middle, t('.label.middle')) %>
        <%= f.text_field :middle %>
        <br>

        <%= f.label(:last, t('.label.last')) %>
        <%= f.text_field :last %>
        <br>

        <%= f.label(:login, t('.label.login')) %>
        <%= f.text_field :login %>
        <span class="wide_field_explanation">
            <small><%= t('.explanation.login_html') %></small>
        </span>
      </div>
    </fieldset>

    <br>

    <fieldset class="groupentry">

      <legend>
        <%= t('.institution_info') %>
      </legend>

      <div class="two-column-grid">

        <%= f.label(:institution, t('.label.institution')) %>
        <%= f.text_field :institution, :size => 60 %>

        <%= f.label(:department, t('.label.department')) %>
        <%= f.text_field :department, :size => 60 %>

        <%= f.label(:position, t('.label.position')) %>
        <%= f.select :position, options_for_select(
            [[t('.select_one'), ""], [t('.position_options.faculty'), "Faculty"],
                                     [t('.position_options.postdoctoral'), "Postdoctoral"],
                                     [t('.position_options.phd_candidate'), "PhD. candidate"],
                                     [t('.position_options.masters_student'), "Masters student"],
                                     [t('.position_options.student'), "Student"],
                                     [t('.position_options.researcher'), "Researcher"],
                                     [t('.position_options.other'), "Other"]
            ],
            @signup.position)
        %>

        <%= f.label(:affiliation, t('.label.affiliation')) %>
        <%= f.select :affiliation, options_for_select(
            [[t('.select_one'), ""], [t('.affiliation_options.academic'), "Academic"],
                                     [t('.affiliation_options.private_sector'), "Private sector"],
                                     [t('.affiliation_options.government'), "Government"],
                                     [t('.affiliation_options.non_profit'), "Non-profit"],
                                     [t('.affiliation_options.other'), "Other"]
            ],
            @signup.affiliation)
        %>

        <%= f.label(:email, t('.label.email')) %>
        <%= f.text_field :email, :size => 60 %>

        <div></div>
        <div class="wide_field_explanation">
          <small><%= t('.explanation.email_html') %></small>

          </small>
        </div>

        <%= f.label(:street1, t('.label.street1')) %>
        <%= f.text_field :street1, :size => 60 %>

        <%= f.label(:street2, t('.label.street2')) %>
        <%= f.text_field :street2, :size => 60 %>

        <%= f.label(:city, t('.label.city')) %>
        <%= f.text_field :city, :size => 30 %>

        <%= f.label(:province, t('.label.province')) %>
        <%= f.text_field :province, :size => 30 %>

        <%= f.label(:country, t('.label.country')) %>
        <%= f.text_field :country, :size => 30 %>

        <%= f.label(:postal_code, t('.label.postal_code')) %>
        <%= f.text_field :postal_code, :size => 8 %>

        <%= f.label(:time_zone, t('time_zone')) %>
        <%= f.time_zone_select :time_zone,
                               ActiveSupport::TimeZone.all.select {|t| t.name =~ /canada/i},
                               {:default => ActiveSupport::TimeZone['Eastern Time (US & Canada)'], :include_blank => true}
        %>

        <%= f.label(:comment, t('signups.common.comment')) %>
        <%= f.text_area :comment, :cols => 80, :rows => 5 %>
        <br>
        <div class="wide_field_explanation">
          <%= t('.explanation.comment_html') %>
        </div>

      <% if current_user.present? && current_user.has_role?(:admin_user) %>
          <%= f.label(:admin_comment, t('.label.admin_comment')) %>
          <%= f.text_area :admin_comment, :cols => 80, :rows => 5 %>
      <% end %>
      </div>
      <br>
    </fieldset>
    <br>
    <div class="centered">
      <%= f.submit(@signup.new_record? ? t('.request_account') : t('.update_request')) %>
    </div>

    <br>
    <b><%= t('.privacy_note') %></b>
    <br>
    <%= t('.privacy_text_html') %>

    <% if RemoteResource.current_resource.support_email.present? %>
      <br>
      <%= t('.contact_html', email: link_to(RemoteResource.current_resource.support_email, "mailto:#{RemoteResource.current_resource.support_email}")) %>
    <% end %>
  </div>
<% end %>
